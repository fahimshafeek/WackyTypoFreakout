          "options": {}
        },
        "id": "91cef4ed-4b91-457e-84db-dce1031a98f1",
        "name": "Respond Success",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1,
        "position": [
          1200,
          100
        ]
      }
