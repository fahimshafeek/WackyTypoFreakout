    "id": "sincerity-check-ad626bb8",
    "name": "Sincerity Check",
    "description": null,
    "active": true,
    "isArchived": false,
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "sincerity-check",
          "responseMode": "responseNode",
          "options": {}
        },
        "id": "71881446-7699-4489-99be-3cb4c0f1c6ec",
        "name": "Webhook",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2.1,
        "position": [
          208,
          304
        ],
        "webhookId": "b447a11a-3d47-41a1-9d13-da5314b0ead6"
      },
      {
        "parameters": {
          "mode": "runOnceForEachItem",
          "jsCode": "\nconst body = $input.item.json.body || {};\nconst text = body.apology_text || '';\nconst minWords = body.min_words || 50;\nconst threshold = body.threshold || 70;\nconst letter = body.letter || 'Unknown';\n\nconst wordCount = text.split(/\\\\s+/).filter(w => w.length > 0).length;\n\nconst prompt = `You ARE the letter \"${letter}\" in a typing game. A player just tried to DELETE you with Backspace and now must apologize TO YOU directly.\n\nYou are hurt, offended, and judging their apology. Respond IN CHARACTER as the letter \"${letter}\" \u2014 use first person (\"I\", \"me\").\n\nRules:\n- sincerity_score 0-100. >= ${threshold} = verdict \"pass\", below = \"fail\"\n- If they used filler, repetition, or nonsense to pad words: FAIL and call them out\n- If genuine and heartfelt: PASS\n- feedback must be 1-2 SHORT sentences MAX, spoken as the letter \"${letter}\" with personality (frustrated, disappointed, or grudgingly accepting)\n\nExamples of good feedback:\n- \"Are you kidding me? You just copy-pasted the same garbage five times. I deserve better than this.\"\n- \"Hmph... fine. That actually made me feel a little appreciated. You may continue.\"\n- \"That was the most hollow, soulless excuse for an apology I have ever read. Try harder.\"\n\nApology to judge:\n\"\"\"\n${text}\n\"\"\"`;\n\n$input.item.json.wordCount = wordCount;\n$input.item.json.minWords = minWords;\n$input.item.json.prompt = prompt;\nreturn $input.item;\n"
        },
        "id": "343f8063-3d2a-4caf-a547-950f573da988",
        "name": "Prepare & Validate",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          400,
          304
        ]
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "strict",
              "version": 3
            },
            "conditions": [
              {
                "id": "e93f6682-1df8-4c90-b997-512c9c5427d7",
                "leftValue": "={{ $json.wordCount }}",
                "rightValue": "={{ $json.minWords }}",
                "operator": {
                  "type": "number",
                  "operation": "gte"
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        },
        "id": "5a905034-4961-4859-88a7-0f5804b314f3",
        "name": "Check Word Count",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.3,
        "position": [
          608,
          304
        ]
      },
      {
        "parameters": {
          "respondWith": "json",
          "responseBody": "={\n  \"sincerity_score\": 0,\n  \"verdict\": \"fail\",\n  \"feedback\": \"Your apology was too short. You need at least {{ $json.minWords }} words.\"\n}",
          "options": {}
        },
        "id": "57f1ef41-6c7f-459d-86d4-edd1779cf50a",
        "name": "Respond Fail (Too Short)",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1,
        "position": [
          800,
          512
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://host.docker.internal:11434/api/chat",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={\n  \"model\": \"llama3.1:8b\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.prompt) }}\n    }\n  ],\n  \"stream\": false,\n  \"options\": {\n    \"temperature\": 0.2\n  },\n  \"format\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"sincerity_score\": { \"type\": \"integer\", \"minimum\": 0, \"maximum\": 100 },\n      \"verdict\": { \"type\": \"string\", \"enum\": [\"pass\", \"fail\"] },\n      \"feedback\": { \"type\": \"string\" }\n    },\n    \"required\": [\"sincerity_score\", \"verdict\", \"feedback\"]\n  }\n}",
          "options": {}
        },
        "id": "13017e32-6ed1-4062-97ed-506e132b4d55",
        "name": "Ollama HTTP Request",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          800,
          112
        ]
      },
      {
        "parameters": {
          "mode": "runOnceForEachItem",
          "jsCode": "\ntry {\n  const content = JSON.parse($input.item.json.message.content);\n  return {\n    json: {\n      sincerity_score: content.sincerity_score || 0,\n      verdict: content.verdict === 'pass' ? 'pass' : 'fail',\n      feedback: content.feedback || 'No feedback provided.'\n    }\n  };\n} catch (e) {\n  return {\n    json: {\n      sincerity_score: 0,\n      verdict: 'fail',\n      feedback: 'The Sincerity Warden was confused by your apology (internal error).'\n    }\n  };\n}\n            "
        },
        "id": "915da9f6-8456-4a22-b848-3100661b1a90",
        "name": "Parse & Guard",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
